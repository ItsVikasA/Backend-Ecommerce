# ============================================================================
#  .env.example - environment variables for the auth-app backend
#
#  Usage:
#    1. Copy this file to `.env`.
#    2. Replace every REPLACE_ME_* value with a real one.
#    3. NEVER commit `.env` to git.
#
#  Note: Spring Boot does not auto-load `.env` files. See STEP 22 for how to
#  load these variables into your shell / IDE run configuration.
# ============================================================================


# -------------------------- MySQL database ---------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=auth_app_db
DB_USERNAME=root
DB_PASSWORD=Vikas@123


# -------------------------- JWT --------------------------------------------
# JWT_SECRET must be Base64-encoded and decode to at least 32 bytes (256 bits)
# for HS256. Generate one with either command below.
#
#   PowerShell:
#     $b=[byte[]]::new(48); [System.Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)
#
#   OpenSSL (Git Bash / WSL / macOS / Linux):
#     openssl rand -base64 48
#
JWT_SECRET=REPLACE_ME_WITH_A_STRONG_BASE64_SECRET

# Access-token lifetime in milliseconds. 3600000 ms = 1 hour.
JWT_EXPIRATION=3600000


# -------------------------- CORS -------------------------------------------
# Comma-separated list of frontend origins allowed to call this backend.
# Default matches the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173
